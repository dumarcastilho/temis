{
  "name": "temis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24" },
  "author": "Dumar Castilho - https://github.com/dumarcastilho",
  "scripts": {
    "dev": "wrangler dev --local",
    "test": "node --test",
    "check": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply temis --local",
    "db:remote": "wrangler d1 migrations apply temis --remote",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": { "jose": "^6.1.0", "fast-xml-parser": "^5.3.0" },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "@cloudflare/workers-types": "^5.20261106.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}
